{
  "name": "skill-hant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "npm run db:generate",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:repair": "prisma db execute --schema=./prisma/schema.prisma --file=./prisma/repair-existing-db.sql",
    "db:rebuild": "node scripts/rebuild-db.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "lucide-react": "^0.542.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "prisma": "^6.15.0"
  }
}
